# Google Cloud Console — OAuth 2.0 Client (Web application)
# https://console.cloud.google.com/apis/credentials
#
# Local dev:
#   Authorized JavaScript origins:  http://localhost:3000
#   Authorized redirect URIs:       http://localhost:8000/api/auth/google/callback
#
# Production (frontend Vercel + API Render):
#   Authorized JavaScript origins:  https://webvory.vercel.app
#   Authorized redirect URIs:         https://webvory.onrender.com/api/auth/google/callback
#   (OAuth callback hits the API host, not the SPA host.)
#
# GOOGLE_REDIRECT_URI is optional when BACKEND_URL is set; it defaults to
# {BACKEND_URL}/api/auth/google/callback

# Database
DATABASE_URL=postgresql+psycopg://webvory:webvory@localhost:5432/webvory

# Auth
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# App URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Set true behind HTTPS in production (auto-derives COOKIE_SAMESITE=none for cross-origin)
COOKIE_SECURE=false
# Optional: lax | strict | none (default: none if COOKIE_SECURE=true, else lax)
# COOKIE_SAMESITE=lax
