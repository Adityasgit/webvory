# Google Cloud Console — OAuth 2.0 Client (Web application)
# 1. Create credentials at https://console.cloud.google.com/apis/credentials
# 2. Authorized JavaScript origins: http://localhost:3000
# 3. Authorized redirect URIs: http://localhost:8000/api/auth/google/callback
# 4. Paste Client ID / Secret below

# Database
DATABASE_URL=postgresql+psycopg://webvory:webvory@localhost:5432/webvory

# Auth
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# App URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Set true behind HTTPS in production
COOKIE_SECURE=false
