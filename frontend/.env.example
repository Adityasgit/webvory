# API host (no trailing slash). Leave unset for same-origin /api paths.
#
# Local dev: unset — Vite proxies /api → http://localhost:8000 (see vite.config.ts).
#
# Production (SPA on Vercel + API on Render): set at build time in Vercel env:
#   VITE_API_URL=https://webvory.onrender.com
# Login uses apiUrl('/api/auth/google') → Render backend (not vercel.app).
# Google Console redirect URI must match Render: .../api/auth/google/callback
#
# Vite inlines VITE_API_URL at build time; changing it in Vercel requires a redeploy.
# VITE_API_URL=http://localhost:8000
