# API host (no trailing slash). Leave unset for same-origin /api paths.
#
# Local dev: unset — Vite proxies /api → http://localhost:8000 (see vite.config.ts).
# Production (SPA on Vercel + API on Render): set at build time, e.g.
#   VITE_API_URL=https://webvory.onrender.com
# Vite inlines this at build time; changing it in Vercel requires a redeploy.
# VITE_API_URL=http://localhost:8000
